{
  "name": "wallet-email-notifs",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "vite build",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create wallet-alerts-db",
    "db:migrate:local": "wrangler d1 migrations apply wallet-alerts-db --local",
    "db:migrate": "wrangler d1 migrations apply wallet-alerts-db --remote",
    "lint": "bunx oxlint src",
    "format": "bunx oxfmt --write src",
    "check": "bun run lint && bun run format"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "hono": "^4.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "viem": "^2.28.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20260401.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.87.0"
  }
}